APP_URL=http://localhost:3000

# PostgreSQL
# Supabase hosted Postgres connection. For serverless hosting, copy the
# Transaction pooler URL from Supabase's Connect dialog.
DATABASE_URL=
DATABASE_SSL=true
# Keep false for encrypted `sslmode=require` behavior. For certificate
# verification, base64-encode the Supabase database CA certificate below.
DATABASE_SSL_REJECT_UNAUTHORIZED=false
DATABASE_SSL_CA_BASE64=
DATABASE_POOL_MAX=1
DATABASE_CONNECTION_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000

# Legacy/local PostgreSQL fallback when DATABASE_URL is empty.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=sthyra_crm
DATABASE_USER=postgres
POSTGRES_PASSWORD=replace-me

# Application sessions and OAuth state signing (minimum 32 characters)
AUTH_SECRET=replace-with-a-long-random-secret
# Optional independent HMAC key for rate-limit subjects. Falls back to
# AUTH_SECRET when omitted. Use at least 32 random characters.
RATE_LIMIT_HASH_SECRET=

# Tenant URLs use <workspace>.crm.sthyra.com. The wildcard DNS record still
# needs to point to Vercel; these credentials automate adding each exact domain
# to this Vercel project after a company is created.
TENANT_DOMAIN_ROOT=crm.sthyra.com
# Temporary migration setting only. When present, the app expires old cookies
# that were shared across all tenant subdomains. New sessions are host-only.
AUTH_COOKIE_DOMAIN=.crm.sthyra.com
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# Supabase Auth. The service-role key is server-only and must never use a
# NEXT_PUBLIC_ prefix or be exposed to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Authenticates external lead-provider requests to /api/lead-intake and /bulk.
# Generate independently from AUTH_SECRET: openssl rand -base64 32
LEAD_INTAKE_SECRET=

# Google login and Gmail sending. Register both callback URLs in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_AUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
GOOGLE_EMAIL_REDIRECT_URI=http://localhost:3000/api/email-connections/google/callback

# Microsoft 365 / Outlook sending. Use "common" for multi-tenant SaaS accounts.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_EMAIL_REDIRECT_URI=http://localhost:3000/api/email-connections/microsoft/callback

# 32 random bytes encoded as base64. Example:
# openssl rand -base64 32
EMAIL_TOKEN_ENCRYPTION_KEY=

# Marketing capture and Google Data Manager. The OAuth callback must exactly
# match the URI configured in Google Cloud.
GOOGLE_MARKETING_CLIENT_ID=
GOOGLE_MARKETING_CLIENT_SECRET=
GOOGLE_MARKETING_REDIRECT_URI=http://localhost:3000/api/marketing/google/callback
# Independent 32-byte base64 secrets. Do not reuse either in browser code.
INTEGRATION_TOKEN_ENCRYPTION_KEY=
MARKETING_HASH_SECRET=replace-with-a-long-random-secret

# Protects scheduled notification, inventory, and marketing workers.
CRON_SECRET=replace-with-a-long-random-secret

# Transactional/product, workspace-invitation, and signup OTP email sent by the
# application. Supabase-managed recovery emails still require SMTP configuration
# in the Supabase Dashboard under Authentication > Emails > SMTP Settings.
SMTP_HOST=...
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=...
SMTP_PASSWORD=...
SMTP_FROM="Sthyra CRM <no-reply@example.com>"
# For Google Workspace, these two aliases can be used by the application
# instead of the SMTP host/user/password/from variables above.
# smtp.gmail.com:587 and "Sthyra CRM <EMAIL_USER>" are assumed.
EMAIL_USER=
GOOGLE_APP_PASSWORD=

# Generic telephony provider adapter and signed provider webhooks
TELEPHONY_PROVIDER=generic
TELEPHONY_PROVIDER_API_URL=
TELEPHONY_PROVIDER_API_KEY=
TELEPHONY_WEBHOOK_SECRET=replace-with-a-long-random-secret
# Local development only. Never enable this in production.
TELEPHONY_ALLOW_SIMULATION=false
